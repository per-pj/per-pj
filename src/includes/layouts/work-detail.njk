---
layout: layouts/base.njk
---

{% set nextItem = collections.works | nextWork(page.url) %}

<article class="work-detail">
  <header class="post-detail-hero-container">
    <div class="post-detail-hero-content">
      {% if tags %}<ul class="post-detail-hero-tags" aria-label="カテゴリー">
        {% for tag in tags %}{% if tag != "work" %}<li>{{ tag }}</li>{% endif %}{% endfor %}
      </ul>{% endif %}
      <h1 class="post-detail-hero-title">{{ title }}</h1>
      {% if description %}<p class="post-detail-hero-desc">{{ description }}</p>{% endif %}
    </div>
    {% if thumbnail %}<div class="post-detail-hero-media"><img src="{{ thumbnail | url }}" alt="{{ title }}" class="post-detail-hero-img" /></div>{% endif %}
  </header>

  {% if content | trim %}<section class="post-detail-content-container">
    <div class="post-detail-content">{{ content | safe }}</div>
  </section>{% endif %}

  <nav class="work-detail-index-link" aria-label="作品一覧へ戻る">
    <a class="text-link" href="{{ '/works/' | url }}">作品一覧を見る</a>
  </nav>

  {% if nextItem %}<section class="next-project" aria-labelledby="next-project-title">
    <a href="{{ nextItem.url | url }}" class="next-project-link">
      <div class="next-project-copy">
        <span class="next-project-label">次の作品</span>
        <h2 id="next-project-title">{{ nextItem.data.title }}</h2>
        {% if nextItem.data.description %}<p>{{ nextItem.data.description }}</p>{% endif %}
        <span class="next-project-action" aria-hidden="true">次へ <span>→</span></span>
      </div>
      {% set nextImage = nextItem.data.thumbnail or nextItem.data.image %}
      {% if nextImage %}<div class="next-project-media"><img src="{{ nextImage | url }}" alt="" /></div>{% endif %}
    </a>
  </section>{% endif %}
</article>

